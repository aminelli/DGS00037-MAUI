<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppPassData.QueryParamsPage"
             Title="QueryParamsPage">

    <ScrollView>

        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Tecnica nr 1: Passaggio per parametru (Query Parameters)" FontSize="18" FontAttributes="Bold" />

            <Entry x:Name="NameEntry" Placeholder="Nome" Text="Tony" />
            <Entry x:Name="AgeEntry" Placeholder="Età" Text="30" />

            <Button Text="Naviga passando i parametri" Clicked="OnNavigateWithParams" />

        </VerticalStackLayout>
        
    </ScrollView>
    
    
</ContentPage>