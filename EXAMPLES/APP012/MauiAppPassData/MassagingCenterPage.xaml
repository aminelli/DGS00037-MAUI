<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppPassData.MassagingCenterPage"
             Title="MassagingCenterPage">
    <ScrollView>

        <VerticalStackLayout>
        
            <Label Text="Tecnica nr 2: Weak Ref. Messenger (Community Toolkit)" FontSize="18" FontAttributes="Bold" />

            
            <Entry x:Name="MessageEntry" Placeholder="Messaggio" Text="Ciao Mondo !!" />
            
            <Button Text="Invia e Naviga" Clicked="OnSendMessage" />

            <Frame BorderColor="Gray" Padding="15" Margin="0,20,0,0">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Risposta Ricevuta:" FontAttributes="Bold" />
                    <Label x:Name="ResponseLabel" Text="In attesa di risposta" FontSize="12" TextColor="Gray"/>
                </VerticalStackLayout>
            </Frame>


        </VerticalStackLayout>

    </ScrollView>
</ContentPage>