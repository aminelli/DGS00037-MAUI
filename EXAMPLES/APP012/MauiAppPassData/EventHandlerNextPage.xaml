<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppPassData.EventHandlerNextPage"
             Title="EventHandlerNextPage">
    <VerticalStackLayout>
        <Label 
            Text="Welcome to .NET MAUI!"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Entry x:Name="DataEntry" Placeholder="Inserire dati" Text="Messaggio" />
        <Button Text="Apri pagina secondaria" Clicked="OnSendDataBack" />
        
    </VerticalStackLayout>
</ContentPage>